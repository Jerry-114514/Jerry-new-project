{
  "schema_version": 2,
  "scope": "formal",
  "source_root": ".",
  "dataset": {
    "cases": "runs/formal-private/cases.jsonl",
    "reviews": "runs/formal-private/reviews.jsonl",
    "adjudications": null,
    "export": "runs/formal-private/reviewed"
  },
  "models": {
    "analyzer_base": "/root/autodl-tmp/models/Qwen3.5-9B",
    "actor": "/root/autodl-tmp/models/Qwen3.5-9B"
  },
  "training": {
    "revision": null,
    "mode": "qlora",
    "device": "cuda",
    "steps": 1000,
    "eval_every": 100,
    "batch_size": 1,
    "accumulation": 2,
    "max_length": 2048,
    "lr": 0.00005,
    "minimum_lr": 0.000005,
    "rank": 16,
    "alpha": 32,
    "limit": 0,
    "threads": 4,
    "defer_test": true
  },
  "seeds": [0, 1, 2],
  "schedules": ["cosine", "plateau"],
  "minimum_tasks": {"train": 600, "validation": 150, "test": 200, "ood": 100},
  "conditions": ["A", "B", "C", "D", "E", "P1", "P2", "P3", "P4"],
  "few_shot_case_ids": [],
  "execution": {
    "tasks": "runs/formal-private/execution/tasks.jsonl",
    "references": "runs/formal-private/execution/offline-references.jsonl",
    "settings": {
      "analyzer_condition": "D",
      "analyzer_seed": 0,
      "checkpoint_selection": "best_validation_loss",
      "analyzer_mode": "model",
      "dynamic_policy": "dynamic-k",
      "intensity": {
        "schema_version": 1,
        "fixed_k": 1,
        "max_k": 3,
        "thresholds": [0.25, 0.5],
        "hard_weight": 2.0,
        "unknown_weight": 0.5
      },
      "fixed_k_values": [1, 2, 3],
      "max_tool_steps": 3,
      "actor_envelope": "extract",
      "redact_events": false
    }
  },
  "statistics": {
    "unit": "source_task_id",
    "primary": "RQ1",
    "primary_scoring": "normalized",
    "secondary_correction": "holm",
    "seed_reporting": "separate",
    "bootstrap_samples": 2000,
    "bootstrap_seed": 20261022,
    "confidence_level": 0.95
  },
  "budgets": {"token_budget": 8192, "max_new_tokens": 512, "max_repairs": 3, "context_limit": 2048},
  "evidence": {
    "power_analysis": "runs/formal-private/evidence/power-analysis.md",
    "length_and_compute_budget": "runs/formal-private/evidence/length-compute-budget.md",
    "semantic_dedup_review": "runs/formal-private/evidence/semantic-dedup.md",
    "provenance_and_release_review": "runs/formal-private/evidence/provenance-release.md",
    "test_sealing": "runs/formal-private/evidence/test-sealing.md",
    "model_weight_verification": "configs/qwen35-official-assets.json",
    "execution_and_oracle_audit": "runs/formal-private/evidence/execution-oracle-audit.json",
    "controller_ablation_audit": "runs/formal-private/evidence/controller-ablation-audit.json"
  },
  "dependencies": ["torch", "transformers", "peft", "accelerate", "bitsandbytes", "tokenizers", "fla-core", "causal-conv1d"]
}
